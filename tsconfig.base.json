{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",

    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    "baseUrl": ".",
    "paths": {
      "@paperclipai/shared": ["packages/shared/src/index.ts"],
      "@paperclipai/shared/*": ["packages/shared/src/*"],
      "@paperclipai/db": ["packages/db/src/index.ts"],
      "@paperclipai/db/*": ["packages/db/src/*"],
      "@paperclipai/adapter-utils": ["packages/adapter-utils/src/index.ts"],
      "@paperclipai/adapter-utils/*": ["packages/adapter-utils/src/*"],
      "@paperclipai/plugin-sdk": ["packages/plugins/sdk/src/index.ts"],
      "@paperclipai/plugin-sdk/ui": ["packages/plugins/sdk/src/ui/index.ts"],
      "@paperclipai/plugin-sdk/*": ["packages/plugins/sdk/src/*"],
      "@paperclipai/adapter-*": ["packages/adapters/*/src/index.ts"],
      "@paperclipai/adapter-*/server": ["packages/adapters/*/src/server/index.ts"],
      "@paperclipai/adapter-*/ui": ["packages/adapters/*/src/ui/index.ts"],
      "@paperclipai/adapter-*/cli": ["packages/adapters/*/src/cli/index.ts"]
    }
  }
}
