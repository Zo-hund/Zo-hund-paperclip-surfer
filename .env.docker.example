# Docker Compose environment template
# Copy this file to .env.docker before running docker compose:
# Copy-Item .env.docker.example .env.docker

# Database connection URL for the single-node local compose stack
DATABASE_URL=postgres://paperclip:paperclip@db:5432/paperclip

# Secret key used for session authentication
BETTER_AUTH_SECRET=generate_your_secret_here

# Public URL served by the local board
PAPERCLIP_PUBLIC_URL=http://localhost:3100

# Server port and UI serving configuration
PORT=3100
SERVE_UI=true

# Security deployment settings
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=private

# Automatically apply database migrations on server start
PAPERCLIP_MIGRATION_AUTO_APPLY=true
