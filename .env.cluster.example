# AMX AIR HUBS cluster deployment example.
# Copy to `.env.cluster` before running `docker compose -f docker-compose.cluster.yml ...`.

# Public URL that browsers should use to reach the board.
PAPERCLIP_PUBLIC_URL=http://localhost:3100

# Required auth secret for Better Auth sessions.
BETTER_AUTH_SECRET=replace_me_with_a_long_random_secret

# Optional provider keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Gemini Live — required for AI voice in meetings
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Resend — required for email notifications
RESEND_API_KEY=
PAPERCLIP_EMAIL_FROM=onboarding@amx-air-hubs.cc
PAPERCLIP_EMAIL_REPLY_TO=support@amx-air-hubs.cc

# LiveKit Cloud — required for voice and video communications
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Allowed hostnames (comma-separated list)
PAPERCLIP_ALLOWED_HOSTNAMES=localhost,127.0.0.1,::1

# Better Auth trusted origins (comma-separated list of URLs)
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3100,https://localhost:3443

# Agent JWT signature secret
PAPERCLIP_AGENT_JWT_SECRET=replace_me_with_a_long_random_secret

# Local postgres bootstrap values.
POSTGRES_DB=paperclip
POSTGRES_USER=paperclip
POSTGRES_PASSWORD=paperclip

# Optional image tag override if you want to pull instead of build locally.
# Example: ghcr.io/<owner>/amx-air-hubs:sha-<commit>
AMX_IMAGE=amx-air-hubs:local
