# Hostinger shared-Traefik deployment template.
# Copy to .env on the remote server or let the GitHub deploy workflow render it.

COMPOSE_PROJECT_NAME=paperclip
APP_SERVICE_NAME=server
DEPLOY_LAYOUT=hostinger-shared-traefik

# Required: Postgres password (set a real value in GitHub Environments secrets)
POSTGRES_PASSWORD=ci-validation-placeholder

AMX_IMAGE=ghcr.io/amx-labs/amx-air-hubs:sha-replace_me
TRAEFIK_DOMAIN=amx-air-hubs.srv1676207.hstgr.cloud
PAPERCLIP_PUBLIC_URL=https://amx-air-hubs.srv1676207.hstgr.cloud

BETTER_AUTH_SECRET=replace_me_with_a_long_random_secret
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Gemini Live — required for AI voice in meetings
GEMINI_API_KEY=

# Resend — required for email notifications
RESEND_API_KEY=
PAPERCLIP_EMAIL_FROM=onboarding@amx-air-hubs.cc
PAPERCLIP_EMAIL_REPLY_TO=support@amx-air-hubs.cc

# LiveKit Cloud — required for voice and video communications
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Allowed hostnames (comma-separated list)
PAPERCLIP_ALLOWED_HOSTNAMES=localhost,127.0.0.1,::1

# Better Auth trusted origins (comma-separated list of URLs)
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3100,https://localhost:3443

# Agent JWT signature secret
PAPERCLIP_AGENT_JWT_SECRET=replace_me_with_a_long_random_secret

# Optional when GHCR package visibility requires an authenticated pull on the VPS.
GHCR_PULL_USERNAME=
GHCR_PULL_TOKEN=
