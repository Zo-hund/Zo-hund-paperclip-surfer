# Hostinger shared-Traefik deployment template.
# Copy to .env on the remote server or let the GitHub deploy workflow render it.

COMPOSE_PROJECT_NAME=paperclip
APP_SERVICE_NAME=server
DEPLOY_LAYOUT=hostinger-shared-traefik

AMX_IMAGE=ghcr.io/amx-labs/amx-air-hubs:sha-replace_me
TRAEFIK_DOMAIN=amx-air-hubs.srv1676207.hstgr.cloud
PAPERCLIP_PUBLIC_URL=https://amx-air-hubs.srv1676207.hstgr.cloud

BETTER_AUTH_SECRET=replace_me_with_a_long_random_secret
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional when GHCR package visibility requires an authenticated pull on the VPS.
GHCR_PULL_USERNAME=
GHCR_PULL_TOKEN=
