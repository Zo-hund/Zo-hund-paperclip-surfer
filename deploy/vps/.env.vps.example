# VPS deployment template for AMX AIR HUBS.
# Copy to .env.vps on the remote server or let the GitHub deploy workflow render it.

COMPOSE_PROJECT_NAME=amx-air-hubs
AMX_IMAGE=ghcr.io/amx-labs/amx-air-hubs:sha-replace_me

TRAEFIK_DOMAIN=amx-air-hubs.cc
TRAEFIK_ACME_EMAIL=ops@example.com
TRAEFIK_ACME_STORAGE=./traefik/acme

PAPERCLIP_PUBLIC_URL=https://amx-air-hubs.cc
PAPERCLIP_DATA_PATH=./paperclip-data

DATABASE_URL=postgres://paperclip:paperclip@db.example.com:5432/paperclip
BETTER_AUTH_SECRET=replace_me_with_a_long_random_secret

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# ── Voice agent (JAZ) extras ─────────────────────────────────────────────────
# Chat LLM for the classic pipeline (default gemini-3.5-flash, GA).
VOICE_LLM_MODEL=
# Vision model override for analyze_screen/analyze_camera (default gemini-2.5-flash).
GEMINI_VISION_MODEL=
# Set to a Gemini Live API model id (e.g. gemini-live-2.5-flash-preview) to
# switch JAZ to realtime speech-to-speech with continuous live video
# understanding. Unset = classic Deepgram/Gemini/Cartesia pipeline.
# NOTE: in realtime mode JAZ speaks with a Gemini native voice, not Cartesia.
VOICE_REALTIME_MODEL=
VOICE_REALTIME_VOICE=Puck
# Runway visual avatar for the meeting-room voice agent. Both must be set for
# the Avatar toggle on the Meetings page to have any effect.
RUNWAYML_API_SECRET=
RUNWAY_AVATAR_ID=

# Optional when GHCR package visibility requires an authenticated pull on the VPS.
GHCR_PULL_USERNAME=
GHCR_PULL_TOKEN=

# ── Email (password reset) ──────────────────────────────────────────────────
# Required for the "Forgot password?" flow. Pick ONE provider.
#
# Option A — Resend (https://resend.com) — recommended, no SMTP needed
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# PAPERCLIP_EMAIL_FROM=Paperclip <noreply@yourdomain.com>
#
# Option B — Generic SMTP (Gmail App Password, SendGrid SMTP, Mailgun, etc.)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=replace_me
# PAPERCLIP_EMAIL_FROM=Paperclip <noreply@yourdomain.com>
#
# If neither is set: reset links are printed to server logs only (dev mode).

# ── OPPRRC VPS-primary storage ───────────────────────────────────────────────
# Root path for the OPPRRC delivery volume inside the container.
PAPERCLIP_OPPRRC_ROOT=/paperclip/opprrc
# Google Drive root folder ID for the AMX-AIR-HUB-FOLDER-OPPRRC Drive folder.
GOOGLE_DRIVE_OPPRRC_ROOT_FOLDER_ID=
# rclone remote name configured on the VPS host (see deploy/vps/rclone.conf.example).
RCLONE_REMOTE=gdrive
# Set to false locally to disable the backup sync worker.
OPPRRC_BACKUP_WORKER_ENABLED=true
