# Paperclip local dev with embedded PGlite (no external Postgres required)
# Copy to .env.local and run: pnpm dev
#
# This file is for developers running `pnpm dev` directly (not Docker).
# PGlite stores data in ./data/pglite by default.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3100
SERVE_UI=false
HOST=127.0.0.1

# Leave DATABASE_URL unset to use embedded PGlite
# DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip

# ── Auth (required — generate a real secret before first run) ─────────────────
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=dev_only_replace_before_any_real_use

# ── Agent JWT (required) ──────────────────────────────────────────────────────
PAPERCLIP_AGENT_JWT_SECRET=dev_only_replace_before_any_real_use

# ── Public URL ────────────────────────────────────────────────────────────────
PAPERCLIP_PUBLIC_URL=http://localhost:3100

# ── AI Provider Keys (optional — comment out unused) ─────────────────────────
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# ── Email (optional) ──────────────────────────────────────────────────────────
# RESEND_API_KEY=

# ── LiveKit (optional) ────────────────────────────────────────────────────────
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# ── Deployment mode ───────────────────────────────────────────────────────────
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=private
