# Public realtime sync. These values are safe to inject into the browser runtime.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional Vite development fallback. Production reads the two values above from /api/config.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Require a verified active member for private Worker APIs when Supabase is configured.
MEMBER_AUTH_REQUIRED=true
TENANT_AUTHORIZATION_REQUIRED=true
# Set to production only after every integration and certification gate is green.
# Production mode automatically requires every advertised runtime component.
DEPLOYMENT_TIER=staging

# Private Worker-only LiveKit credentials. Never expose API_SECRET in Vite client variables.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Private Worker-only Decart key. The browser receives only short-lived, Lucy-scoped client tokens.
DECART_API_KEY=
LIVEKIT_AGENT_NAME=
# Subscribe-only viewer tokens are issued only for these rooms.
PUBLIC_LIVEKIT_ROOMS=AMXSTAGE
# Publish-capable tokens and stage-monitor identities are issued only on these hosts.
LIVEKIT_OPERATOR_HOSTS=localhost,127.0.0.1,your-private-operator.example.com
# Durable show-workflow reads and writes are limited to these private hosts.
# Falls back to LIVEKIT_OPERATOR_HOSTS when omitted.
STAGE_OPERATOR_HOSTS=localhost,127.0.0.1,your-private-operator.example.com

# Private DJ livestream controls. Keep full platform ingest URLs and stream keys Worker-only.
# Separate up to five RTMP/RTMPS destinations with commas or new lines.
DJ_RTMP_URLS=rtmps://your-platform.example/live/your-private-stream-key
DJ_STREAM_CONTROL_TOKEN=

# Private Runway Characters API key. Used only by the Worker to create billable realtime sessions.
RUNWAYML_API_SECRET=

# Private Printful fulfillment and collective-commerce runtime.
PRINTFUL_API_TOKEN=
PRINTFUL_STORE_ID=
# Optional fallback for a non-Stripe hosted payment provider.
MERCH_CHECKOUT_URL=https://checkout.example.com/amx-merch
MERCH_PAYMENT_WEBHOOK_TOKEN=
MERCH_PRINTFUL_WEBHOOK_TOKEN=
MERCH_PUBLIC_BASE_URL=https://amx-hubs.cc
MERCH_ALLOWED_COUNTRIES=US,CA

# Stripe-hosted Checkout and Connect. Keep both values Worker-only.
# Register Checkout, account.updated, transfer.updated, and transfer.reversed events at /api/merch/stripe-webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional legacy/private Ready Player Me creator. The public hosted service retired in 2026.
# Exported Ready Player Me GLB files can always be imported directly in the Nexus room.
VITE_READY_PLAYER_ME_CREATOR_URL=

# Browser-public Google Maps key. Restrict it to the deployed HTTPS origin and Maps JavaScript API.
GOOGLE_MAPS_BROWSER_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Optional server-only agent orchestration endpoint. The Worker calls {URL}/respond.
AGENT_RUNTIME_URL=https://agents.example.com/
AGENT_RUNTIME_TOKEN=

# Optional allowlisted gateways. Each gateway receives POST requests at {URL}/invoke.
MCP_GATEWAY_URL=https://mcp-gateway.example.com/
MCP_GATEWAY_TOKEN=
PLUGIN_GATEWAY_URL=https://plugins.example.com/
PLUGIN_GATEWAY_TOKEN=

# Production operations. The webhook receives bounded JSON alerts for server errors.
# The heartbeat token protects automated release and uptime probes.
OPS_ALERT_WEBHOOK_URL=https://alerts.example.com/amx
OPS_ALERT_WEBHOOK_TOKEN=
OPS_HEARTBEAT_TOKEN=

# Server-side proof attestation. Generate at least 32 random bytes for production.
PROOF_SIGNING_SECRET=

# Bearer secret used only by trusted Redfish, SNMP, Modbus, or DCIM adapters.
DCIM_INGEST_TOKEN=

# Optional readiness policy. Comma-separated values:
# database,media,realtime,rooms,agent,mcp,plugins,livekit,runway,proof-signing,telemetry,observability
# /api/ready returns 503 when a required integration is unavailable.
REQUIRED_SERVICES=database,media,proof-signing

# DB and MEDIA are platform bindings declared in .openai/hosting.json, not secrets.
# Mission World progressive-delivery flags
VITE_ENABLE_MISSION_WEBXR=true
VITE_ENABLE_MISSION_MULTIPLAYER=false
