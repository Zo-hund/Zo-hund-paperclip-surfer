# Public realtime sync. These values are safe to inject into the browser runtime.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional Vite development fallback. Production reads the two values above from /api/config.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Require a verified active member for private Worker APIs when Supabase is configured.
MEMBER_AUTH_REQUIRED=true
TENANT_AUTHORIZATION_REQUIRED=true
# Set to production only after every integration and certification gate is green.
# Production mode automatically requires every advertised runtime component.
DEPLOYMENT_TIER=staging

# AMX portable infrastructure contracts. Sites supplies DB/MEDIA bindings today;
# these URLs are reserved for the PostgreSQL, queue, and object-storage services.
AMX_DATABASE_URL=
AMX_REDIS_URL=
AMX_STORAGE_URL=
AMX_STORAGE_BUCKET=

# Private Worker-only LiveKit credentials. Never expose API_SECRET in Vite client variables.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Private Worker-only Decart key. The browser receives only short-lived, Lucy-scoped client tokens.
DECART_API_KEY=
LIVEKIT_AGENT_NAME=
# Subscribe-only viewer tokens are issued only for these rooms.
PUBLIC_LIVEKIT_ROOMS=AMXSTAGE
# Publish-capable tokens and stage-monitor identities are issued only on these hosts.
LIVEKIT_OPERATOR_HOSTS=localhost,127.0.0.1,your-private-operator.example.com
# Durable show-workflow reads and writes are limited to these private hosts.
# Falls back to LIVEKIT_OPERATOR_HOSTS when omitted.
STAGE_OPERATOR_HOSTS=localhost,127.0.0.1,your-private-operator.example.com

# Private DJ livestream controls. Keep full platform ingest URLs and stream keys Worker-only.
# Separate up to five RTMP/RTMPS destinations with commas or new lines.
DJ_RTMP_URLS=rtmps://your-platform.example/live/your-private-stream-key
DJ_STREAM_CONTROL_TOKEN=

# Private Runway Characters API key. Used only by the Worker to create billable realtime sessions.
RUNWAYML_API_SECRET=

# Private Runpod Serverless compute. Use a restricted key scoped only to the
# listed endpoints. Results are captured to MEDIA before async retention ends.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_LIVE_ENDPOINT_ID=
RUNPOD_RENDER_ENDPOINT_ID=
RUNPOD_TRAINING_ENDPOINT_ID=
RUNPOD_WEBHOOK_SECRET=
RUNPOD_CALLBACK_BASE_URL=https://amx-hubs.cc
RUNPOD_MONTHLY_BUDGET_CENTS=25000
RUNPOD_PER_JOB_LIMIT_CENTS=2500
RUNPOD_B200_RATE_CENTS_HOUR=864
RUNPOD_LIVE_RATE_CENTS_HOUR=350

# Private Printful fulfillment and collective-commerce runtime.
PRINTFUL_API_TOKEN=
PRINTFUL_STORE_ID=
# Optional fallback for a non-Stripe hosted payment provider.
MERCH_CHECKOUT_URL=https://checkout.example.com/amx-merch
MERCH_PAYMENT_WEBHOOK_TOKEN=
MERCH_PRINTFUL_WEBHOOK_TOKEN=
MERCH_PUBLIC_BASE_URL=https://amx-hubs.cc
MERCH_ALLOWED_COUNTRIES=US,CA

# Stripe-hosted Checkout and Connect. Keep both values Worker-only.
# Register Checkout, account.updated, transfer.updated, and transfer.reversed events at /api/merch/stripe-webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Provider-neutral payment and wallet policy runtime.
AMX_PAYMENT_MODE=simulation
AMX_PAYMENT_DEFAULT_CURRENCY=USD
AMX_PAYMENT_IDEMPOTENCY_SECRET=
AMX_WALLET_CUSTODY_URL=
AMX_WALLET_CUSTODY_TOKEN=

# x402 machine-payment adapter. Settlement stays disabled until every value is
# configured and an operator explicitly changes AMX_PAYMENT_MODE.
X402_FACILITATOR_URL=
X402_NETWORK=
X402_WALLET_ADDRESS=
X402_SIGNING_KEY=
X402_SETTLEMENT_ENABLED=false

# Optional chain-neutral stablecoin/NFT representation provider. Private keys
# must remain in custody infrastructure and never appear in this application.
CRYPTO_PROVIDER_URL=
CRYPTO_PROVIDER_TOKEN=
CRYPTO_NETWORK=

# Wearable resolver and AR delivery contracts.
AMX_WEARABLE_RESOLVER_URL=https://amx-hubs.cc/api/v1/scan
AMX_WEARABLE_SIGNING_SECRET=
AMX_AR_ASSET_BASE_URL=https://amx-hubs.cc/api/media

# TECH AT NITE membership subscriptions. Create recurring Stripe Prices, then
# bind each price ID here. Amounts and billing intervals are read from Stripe.
MEMBERSHIP_PUBLIC_BASE_URL=https://amx-hubs.cc
MEMBERSHIP_STRIPE_WEBHOOK_SECRET=
MEMBERSHIP_PRICE_LEARNER=
MEMBERSHIP_PRICE_BUILDER=
MEMBERSHIP_PRICE_AMBASSADOR=
MEMBERSHIP_PRICE_EARNER=
MEMBERSHIP_PRICE_PARENT=
MEMBERSHIP_PRICE_COMMUNITY=
MEMBERSHIP_PRICE_VOLUNTEER=
MEMBERSHIP_PRICE_SPONSOR=
MEMBERSHIP_PRICE_DONOR=

# Human-readable release identifier returned by /api/health.
DEPLOYMENT_REVISION=local

# Optional legacy/private Ready Player Me creator. The public hosted service retired in 2026.
# Exported Ready Player Me GLB files can always be imported directly in the Nexus room.
VITE_READY_PLAYER_ME_CREATOR_URL=

# Browser-public Google Maps key. Restrict it to the deployed HTTPS origin and Maps JavaScript API.
GOOGLE_MAPS_BROWSER_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Optional server-only agent orchestration endpoint. The Worker calls {URL}/respond.
AGENT_RUNTIME_URL=https://agents.example.com/
AGENT_RUNTIME_TOKEN=
AMX_AGENT_CONTROL_TOKEN=
AMX_BOARD_API_BASE_URL=https://amx-hubs.cc
# SHA-256 hex digest of the spoken operator ZKODE. Never store the plain PIN.
AMX_AGENT_OPERATOR_ZKODE_HASH=

# AIR Connect edge command boundary. Use independent random values and keep
# them on the Worker and registered edge node only.
AIR_EDGE_NODE_TOKEN=
AIR_EDGE_COMMAND_SIGNING_KEY=
# Edge process configuration (not browser variables).
AMX_HUBS_BASE_URL=https://amx-hubs.cc
AIR_EDGE_TENANT_ID=tech-at-nite
AIR_EDGE_NODE_ID=edge-hub-001
AIR_EDGE_ADAPTER_URL=http://127.0.0.1:9090
AIR_EDGE_ADAPTER_TOKEN=
# Explicit local/demo mode. Never use this to claim a physical router changed.
AIR_EDGE_SIMULATION=false

# Hybrid physical gateway adapter. OPNsense pipe UUIDs are pre-provisioned per
# VLAN; UniFi authorizes captive-portal clients; T-Mobile is telemetry only.
AIR_HYBRID_HOST=127.0.0.1
AIR_HYBRID_PORT=9090
AIR_HYBRID_ENFORCEMENT=opnsense
OPNSENSE_URL=https://192.168.20.1
OPNSENSE_API_KEY=
OPNSENSE_API_SECRET=
OPNSENSE_ROOM_POLICIES_JSON={"120":{"downloadPipeUuid":"replace","uploadPipeUuid":"replace"}}
UNIFI_NETWORK_URL=https://192.168.20.2
UNIFI_API_KEY=
UNIFI_SITE_ID=
OPENWRT_ADAPTER_URL=
OPENWRT_ADAPTER_TOKEN=
TMOBILE_GATEWAY_URL=http://192.168.12.1

# Optional allowlisted gateways. Each gateway receives POST requests at {URL}/invoke.
MCP_GATEWAY_URL=https://mcp-gateway.example.com/
MCP_GATEWAY_TOKEN=
PLUGIN_GATEWAY_URL=https://plugins.example.com/
PLUGIN_GATEWAY_TOKEN=

# H3AT workspace to AMX AIR Hubs governed control-plane capability.
# Sites currently supports the legacy AMX-HUBS-CONNECT binding; new environments
# should prefer this underscore-safe alias.
AMX_HUBS_CONNECT_API_KEY=

# Production operations. The webhook receives bounded JSON alerts for server errors.
# The heartbeat token protects automated release and uptime probes.
OPS_ALERT_WEBHOOK_URL=https://alerts.example.com/amx
OPS_ALERT_WEBHOOK_TOKEN=
OPS_HEARTBEAT_TOKEN=

# Server-side proof attestation. Generate at least 32 random bytes for production.
PROOF_SIGNING_SECRET=

# Bearer secret used only by trusted Redfish, SNMP, Modbus, or DCIM adapters.
DCIM_INGEST_TOKEN=

# Optional readiness policy. Comma-separated values:
# database,media,realtime,rooms,agent,mcp,plugins,livekit,runway,runpod,proof-signing,telemetry,observability
# /api/ready returns 503 when a required integration is unavailable.
REQUIRED_SERVICES=database,media,proof-signing

# DB and MEDIA are platform bindings declared in .openai/hosting.json, not secrets.
# Mission World progressive-delivery flags
VITE_ENABLE_MISSION_WEBXR=true
VITE_ENABLE_MISSION_MULTIPLAYER=false
