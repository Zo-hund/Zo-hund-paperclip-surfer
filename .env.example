# Paperclip local development environment
# Copy to .env and fill in values before running `pnpm dev` or `pnpm dev:server`
#
# For local dev with embedded PGlite (no external Postgres needed), leave DATABASE_URL unset.
# For Docker Compose dev, set DATABASE_URL to the postgres service URL.

# ── Database ──────────────────────────────────────────────────────────────────
# Leave unset to use embedded PGlite (default for `pnpm dev`)
# DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3100
SERVE_UI=false
HOST=127.0.0.1

# ── Auth (required) ───────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace_me_with_a_long_random_secret_32_chars_min

# ── Agent JWT (required) ──────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAPERCLIP_AGENT_JWT_SECRET=replace_me_with_a_long_random_secret_32_chars_min

# ── Public URL ────────────────────────────────────────────────────────────────
PAPERCLIP_PUBLIC_URL=http://localhost:3100

# ── AI Provider Keys (optional — only needed for agent execution) ─────────────
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_API_KEY=

# ── Email (optional — required for email notifications) ───────────────────────
# RESEND_API_KEY=
# PAPERCLIP_EMAIL_FROM=onboarding@example.com
# PAPERCLIP_EMAIL_REPLY_TO=support@example.com

# ── LiveKit Voice/Video (optional) ────────────────────────────────────────────
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# ── Deployment ────────────────────────────────────────────────────────────────
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=private
